# Entorno de ejecución: local | staging | production
APP_ENV=local

# Postgres (driver async). Ejemplo local con docker-compose:
DATABASE_URL=postgresql+asyncpg://guatson:guatson@localhost:5432/guatson

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-token-de-BotFather
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio
# IDs de Telegram separados por coma que puede usar el bot (uso personal)
TELEGRAM_ALLOWED_USER_IDS=123456789
# URL pública del servicio (la usa scripts/set_webhook.py). No aplica en modo polling.
PUBLIC_BASE_URL=https://tu-app.fly.dev

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096

# Comportamiento del agente
HISTORY_MAX_MESSAGES=40
AGENT_MAX_ITERATIONS=8
