# Entorno de ejecución: local | staging | production
APP_ENV=local

# Postgres (driver async). Debe coincidir con POSTGRES_USER/PASSWORD/DB de abajo si usas
# docker-compose; si corres la app fuera de Docker contra el Postgres del compose, usa
# localhost en vez de "db" como host.
DATABASE_URL=postgresql+asyncpg://guatson:CHANGE_ME_STRONG_PASSWORD@localhost:5432/guatson

# Solo los usa docker-compose.yml para levantar el contenedor `db` (no se leen en
# ningún otro lado). Pon aquí una contraseña real y propia, no el valor de ejemplo.
POSTGRES_USER=guatson
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=guatson

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-token-de-BotFather
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio
# IDs de Telegram separados por coma que puede usar el bot (uso personal)
TELEGRAM_ALLOWED_USER_IDS=123456789
# URL pública del servicio (la usa scripts/set_webhook.py). No aplica en modo polling.
PUBLIC_BASE_URL=https://tu-app.fly.dev

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096

# Comportamiento del agente
HISTORY_MAX_MESSAGES=40
AGENT_MAX_ITERATIONS=8

# Transcripción de notas de voz (opcional): sin OPENAI_API_KEY el bot funciona igual
# para texto, y una nota de voz responde que la transcripción no está disponible.
# Ver docs/specs/audio-transcription.md.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_BYTES=20971520
